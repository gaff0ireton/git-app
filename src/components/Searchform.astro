<div class="command-filter__search" role="search">
  <label for="command-search" class="visually-hidden"> コマンドを検索 </label>
  <input type="search" class="command-search" placeholder="コマンドを検索..." />
</div>

<script>
  import { filterCards } from '../scripts/filterCards';
  import { updateCards } from '../scripts/ui';
  import { resetCategory } from '../scripts/resetCategory';

  const input = document.querySelector<HTMLInputElement>('.command-search');
  const btns = document.querySelectorAll('.filter-button');
  const cards = [...document.querySelectorAll<HTMLElement>('.card')];

  input?.addEventListener('input', () => {
    const keyword = input.value;

    // カテゴリ選択をリセット
    resetCategory(btns);

    // 検索
    const filteredCards = filterCards(cards, keyword);

    // UI更新
    updateCards(cards, filteredCards);
  });
</script>
