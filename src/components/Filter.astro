---
const categories = [
  { label: 'All', value: 'all' },
  { label: 'Basic', value: 'basic' },
  { label: 'Branch', value: 'branch' },
  { label: 'Commit', value: 'commit' },
  { label: 'Remote', value: 'remote' },
  { label: 'Stash', value: 'stash' },
  { label: 'Undo', value: 'undo' },
];
---

<div class="command-filter__nav" role="group">
  <ul class="command-filter__list">
    {
      categories.map((item) => (
        <li>
          <button
            class:list={[
              'filter-button',
              {
                'is-active': item.label === 'All',
              },
            ]}
            type="button"
            data-category={item.value}
          >
            {item.label}
          </button>
        </li>
      ))
    }
  </ul>
</div>

<script>
  import { filterByCategory } from '../scripts/filterCategory';
  import { updateCards, updateActiveButton } from '../scripts/ui';

  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-button');
  const input = document.querySelector<HTMLInputElement>('.command-search');
  const cards = [...document.querySelectorAll<HTMLElement>('.card')];

  function render(category: string) {
    const filteredCards = filterByCategory(cards, category);

    updateCards(cards, filteredCards);
  }

  // 初期表示
  render('all');

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      const category = button.dataset.category ?? 'all';

      updateActiveButton(buttons, button);
      render(category);

      if (input) input.value = '';
    });
  });
</script>
