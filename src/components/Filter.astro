---
const categories = [
  { label: 'All', value: 'all' },
  { label: 'Basic', value: 'basic' },
  { label: 'Branch', value: 'branch' },
  { label: 'Commit', value: 'commit' },
  { label: 'Remote', value: 'remote' },
  { label: 'Stash', value: 'stash' },
  { label: 'Undo', value: 'undo' },
];
---

<div class="command-filter__nav" role="group">
  <ul class="command-filter__list">
    {
      categories.map((item) => (
        <li>
          <button
            class:list={[
              'filter-button',
              {
                'is-active': item.label === 'All',
              },
            ]}
            type="button"
            data-category={item.value}
          >
            {item.label}
          </button>
        </li>
      ))
    }
  </ul>
</div>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-button');
  const input = document.querySelector<HTMLInputElement>('.command-search');

  function render(button) {
    const category = button?.dataset.category ?? buttons[0].dataset.category;
    const activeButton = document.querySelector('.filter-button.is-active');
    const numberText = document.querySelector('.number-text');

    if (button) {
      activeButton.classList.remove('is-active');
      button.classList.add('is-active');
    }

    const cards = [...document.querySelectorAll<HTMLElement>('.card')];

    const filteredCards = cards.filter((card) => {
      return category === 'all' || card.dataset.category === category;
    });

    console.log(filteredCards.length);

    numberText.textContent = `全${filteredCards.length}件`;

    cards.forEach((card) => {
      if (category === 'all') {
        card.classList.remove('is-not');
      } else if (!filteredCards.includes(card)) {
        card.classList.add('is-not');
      } else {
        card.classList.remove('is-not');
      }
    });
  }

  render();

  buttons.forEach((button) => {
    button.addEventListener('click', (e) => {
      render(button);
      if (input) input.value = '';
    });
  });
</script>
